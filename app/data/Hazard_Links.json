      "path": "Fewest arrows from the hazard node to any observed node, inside the indicator's own NASA risk diagram(s). Arrows copied from the diagram code files.",
      "closeness_rules": {
        "close": "1 or 2 arrows, and observability high or partial",
        "intermediate": "3 arrows, and observability high or partial",
        "distant": "4 or more arrows, or observability low, or a held source says the effect along this path is long-term disease",
        "not_linked": "no path inside the indicator's own diagram(s)"
      },
      "evidence_grades": {
        "E1": "a spaceflight study measured this indicator or the same body quantity",
        "E2": "only a related marker, or only an Earth analog",
        "E3": "no measurement in the held sources"
      },
      "not_meaning": "Closeness is not an effect size or a likelihood. It must never be used to say which hazard caused a reading."
    },
